.PHONY: check traefik
# Yaegi v0.16.1 is what Traefik v3.0.4 embeds; `go run` fetches it at that version (nothing installed locally).
YAEGI := go run github.com/traefik/yaegi/cmd/yaegi@v0.16.1

check:  ## formatting, vet, the tests under Go and under Yaegi, the tests module (no Docker)
	@test -z "$$(gofmt -l .)" || { echo "not gofmt-formatted:"; gofmt -l .; exit 1; }
	go vet ./...
	go test ./...
	$(YAEGI) test .
	cd tests && go vet ./... && go vet -tags traefik ./... && go test ./...
traefik:  ## the plugin in a real Traefik v3.0.4 container (needs Docker)
	cd tests && go test -tags traefik ./...
